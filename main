    local ambientLoop = Instance.new("Sound")
    ambientLoop.SoundId = "rbxassetid://134336321560595"
    ambientLoop.Volume = 10
    ambientLoop.Looped = true
    ambientLoop:SetAttribute("ExemptFromMute", true)
