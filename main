local muted = {}
local function muteSound(s)
    if not s then return end
    if sound and s == sound then return end
    local ok, exempt = pcall(function() return s:GetAttribute("ExemptFromMute") end)
    if ok and exempt then return end
    if muted[s] then return end
    local okV, v = pcall(function() return s.Volume end)
    if not okV then return end
    muted[s] = v
    pcall(function() s.Volume = 0 end)
end

pcall(function()
    for _, d in ipairs(game:GetDescendants()) do
        if d:IsA("Sound") then
            muteSound(d)
        end
    end
end)

pcall(function()
    game.DescendantAdded:Connect(function(d)
        if d:IsA("Sound") then
            task.defer(muteSound, d)
        end
    end)
end)

local blackened = {}
local blackenQueue = {}

local function buildBlackenQueue()
    blackenQueue = {}
    for _, d in ipairs(Workspace:GetDescendants()) do
        if d:IsA("BasePart") and not blackened[d] then
            local skip = false
            for _, plr in ipairs(Players:GetPlayers()) do
                local ch = plr.Character
                if ch and d:IsDescendantOf(ch) then
                    skip = true
                    break
                end
            end
            if not skip then
                table.insert(blackenQueue, d)
            end
        end
    end
    for i = #blackenQueue, 2, -1 do
        local j = math.random(1, i)
        blackenQueue[i], blackenQueue[j] = blackenQueue[j], blackenQueue[i]
    end
end

task.spawn(function()
    buildBlackenQueue()
    while true do
        task.wait(1.5)
        if #blackenQueue == 0 then
            task.wait(5)
            buildBlackenQueue()
        else
            local p = table.remove(blackenQueue)
            if p and p.Parent and not blackened[p] then
                blackened[p] = true
                pcall(function()
                    p.Color = Color3.new(0, 0, 0)
                    p.Material = Enum.Material.SmoothPlastic
                end)
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(0.1)
        local w = Workspace:FindFirstChild("Woody")
        if w then
            for _, d in ipairs(w:GetDescendants()) do
                if d:IsA("BasePart") and d.CanCollide then
                    pcall(function() d.CanCollide = false end)
                end
            end
        end
    end
end)

local pasteScheduled = false

local function walkPath(root, ...)
    local c = root
    local names = {...}
    for i = 1, #names do
        if not c then return nil end
        local ok, nxt = pcall(function() return c:FindFirstChild(names[i]) end)
        if not ok then return nil end
        c = nxt
    end
    return c
end

local function getTeamList()
    return walkPath(
        CoreGui,
        "PlayerList", "Children", "OffsetFrame", "PlayerScrollList",
        "SizeOffsetFrame", "Column", "Body", "ScrollingFrameClippingFrame",
        "ScrollingFrame", "OffsetUndoFrame", "TeamList_Neutral"
    )
end

local function getNameLabel(frame)
    if not frame then return nil end
    local content = frame:FindFirstChild("PlayerEntryContentFrame")
    if not content then return nil end
    local overlay = content:FindFirstChild("OverlayFrame")
    if not overlay then return nil end
    local nf = overlay:FindFirstChild("NameFrame")
    if not nf then return nil end
    local pn = nf:FindFirstChild("PlayerName")
    if not pn then return nil end
    local label = pn:FindFirstChild("PlayerName")
    if label and label:IsA("TextLabel") then return label end
    return nil
end

local function hasFriendIn(tl)
    if not tl then return false end
    for _, child in ipairs(tl:GetChildren()) do
        local label = getNameLabel(child)
        if label and label.Text == FRIEND_TEXT then return true end
    end
    return false
end

local savedLegacyTemplate = nil

local function pasteFriendNow()
    if not savedLegacyTemplate then return end
    local tl = getTeamList()
    if not tl then return end
    if hasFriendIn(tl) then return end
    local ok, copy = pcall(function() return savedLegacyTemplate:Clone() end)
    if not ok or not copy then return end
    pcall(function()
        copy.Name = "PlayerEntry_Friend"
        copy.Parent = tl
    end)
    local label = getNameLabel(copy)
    if label then
        pcall(function() label.Text = FRIEND_TEXT end)
    end
    if H and H.startWoody then pcall(H.startWoody) end
end

local function schedulePaste(delay)
    if pasteScheduled then return end
    pasteScheduled = true
    task.delay(delay, function()
        pasteScheduled = false
        pcall(pasteFriendNow)
    end)
end

local function processTeamList()
    local tl = getTeamList()
    if not tl then return end
    local toDelete = {}
    for _, child in ipairs(tl:GetChildren()) do
        local label = getNameLabel(child)
        if label and label.Text ~= localName and label.Text ~= FRIEND_TEXT then
            if not savedLegacyTemplate then
                local ok, clone = pcall(function() return child:Clone() end)
                if ok and clone then savedLegacyTemplate = clone end
            end
            table.insert(toDelete, child)
        end
    end
    for _, f in ipairs(toDelete) do
        pcall(function() f:Destroy() end)
    end
    return #toDelete > 0
end

processTeamList()
schedulePaste(15)

task.spawn(function()
    while true do
        task.wait(1)
        local tl = getTeamList()
        if tl then
            local hasReal = false
            local friendPresent = false
            for _, child in ipairs(tl:GetChildren()) do
                local label = getNameLabel(child)
                if label then
                    if label.Text == FRIEND_TEXT then
                        friendPresent = true
                    elseif label.Text ~= localName then
                        hasReal = true
                    end
                end
            end
            if hasReal then
                processTeamList()
                schedulePaste(5)
            elseif not friendPresent and not pasteScheduled and savedLegacyTemplate then
                pcall(pasteFriendNow)
            end
        end
    end
end)

task.wait(10)

pcall(function()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return end
    local interfaceGui = playerGui:FindFirstChild("InterfaceGui")
    if not interfaceGui then return end
    local timer = interfaceGui:FindFirstChild("Timer")
    if not timer then return end
    local clone = timer:Clone()
    local parent = timer.Parent
    timer:Destroy()
    clone.Parent = parent
    local function setErrorText(inst)
        if inst:IsA("TextLabel") then
            pcall(function() inst.Text = "Error" end)
        end
        for _, child in ipairs(inst:GetDescendants()) do
            if child:IsA("TextLabel") then
                pcall(function() child.Text = "Error" end)
            end
        end
    end
    setErrorText(clone)
end)

local NIGHT_SKY_TAG = "OurNightSky"

local function ensureNightSky()
    local ourSky
    for _, obj in ipairs(Lighting:GetChildren()) do
        if obj:IsA("Sky") then
            if obj:GetAttribute(NIGHT_SKY_TAG) then
                ourSky = obj
            else
                pcall(function() obj:Destroy() end)
            end
        end
    end
    if not ourSky then
        local sky = Instance.new("Sky")
        sky.StarCount = 0
        sky.CelestialBodiesShown = false
        sky:SetAttribute(NIGHT_SKY_TAG, true)
        sky.Parent = Lighting
        ourSky = sky
    end
    return ourSky
end

ensureNightSky()

pcall(function()
    Lighting.ChildAdded:Connect(function(child)
        if child:IsA("Sky") and not child:GetAttribute(NIGHT_SKY_TAG) then
            task.defer(ensureNightSky)
        end
    end)
end)

pcall(function()
    Lighting.ChildRemoved:Connect(function(child)
        if child:IsA("Sky") and child:GetAttribute(NIGHT_SKY_TAG) then
            task.defer(ensureNightSky)
        end
    end)
end)

for _, name in ipairs({"Realistic", "Future", "ShadowMap"}) do
    local ok = pcall(function()
        Lighting.Technology = Enum.Technology[name]
    end)
    if ok then break end
end

local function isFlashlight(inst)
    local c = inst
    while c do
        if typeof(c.Name) == "string" then
            local lower = string.lower(c.Name)
            if string.find(lower, "flashlight", 1, true)
                or string.find(lower, "lantern", 1, true)
                or string.find(lower, "torch", 1, true) then
                return true
            end
        end
        if c:IsA("Tool") then
            local parent = c.Parent
            if parent then
                local ok, owner = pcall(function() return Players:GetPlayerFromCharacter(parent) end)
                if ok and owner == LocalPlayer then return true end
            end
        end
        c = c.Parent
    end
    return false
end

local LIGHT_DIM_FACTOR = 0.07

local function killLight(light, info)
    if not light or not light.Parent then return end
    local okF, isF = pcall(isFlashlight, light)
    if okF and isF then return end
    pcall(function()
        TweenService:Create(light, info, { Brightness = light.Brightness * LIGHT_DIM_FACTOR }):Play()
    end)
end

local TWEEN_TIME = 10
local targetCT = 0

local tweenInfo = TweenInfo.new(
    TWEEN_TIME,
    Enum.EasingStyle.Sine,
    Enum.EasingDirection.InOut
)

pcall(function()
    for _, d in ipairs(Workspace:GetDescendants()) do
        if d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight") then
            killLight(d, tweenInfo)
        end
    end
end)

local lightConn
pcall(function()
    lightConn = Workspace.DescendantAdded:Connect(function(d)
        if d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight") then
            task.defer(killLight, d, tweenInfo)
        end
    end)
end)

pcall(function()
    TweenService:Create(Lighting, tweenInfo, {
        ClockTime = targetCT,
        Brightness = 0.8,
        Ambient = Color3.fromRGB(16, 16, 24),
        OutdoorAmbient = Color3.fromRGB(28, 28, 40),
        FogEnd = 300,
        FogStart = 35,
        FogColor = Color3.fromRGB(17, 17, 25),
    }):Play()
end)

task.delay(TWEEN_TIME + 0.05, function()
    pcall(function() Lighting.ClockTime = targetCT end)
    if lightConn then
        pcall(function() lightConn:Disconnect() end)
    end

    local function enforceNight()
        pcall(function()
            if Lighting.ClockTime ~= targetCT then
                Lighting.ClockTime = targetCT
            end
        end)
        pcall(ensureNightSky)
    end

    pcall(function()
        Lighting:GetPropertyChangedSignal("ClockTime"):Connect(function()
            if Lighting.ClockTime ~= targetCT then
                task.defer(enforceNight)
            end
        end)
    end)

    task.spawn(function()
        while true do
            enforceNight()
            task.wait(0.1)
        end
    end)
end)

local WOODY_FILE = "woody.rbxmx"
local WOODY_URL = "https://raw.githubusercontent.com/BarkleyGerard/helloneighborbetashit/refs/heads/main/woody.rbxmx"
local WOODY_SOUND_ID = "rbxassetid://121065304063932"
local MUSIC_ID = "rbxassetid://105523977239806"

local function loadWoodyModel()
    local okIO, needDownload = pcall(function()
        if type(isfile) ~= "function" then return true end
        local ok, exists = pcall(isfile, WOODY_FILE)
        return not (ok and exists)
    end)
    if not okIO then return nil end

    if needDownload then
        if type(request) ~= "function" then return nil end
        local okReq, response = pcall(function()
            return request({ Url = WOODY_URL, Method = "GET" })
        end)
        if not okReq or not response or not response.Success then return nil end
        if type(writefile) ~= "function" then return nil end
        local okWrite = pcall(writefile, WOODY_FILE, response.Body)
        if not okWrite then return nil end
    end

    if type(getcustomasset) ~= "function" then return nil end

    local okAsset, assetId = pcall(getcustomasset, WOODY_FILE)
    if not okAsset or not assetId then return nil end

    local objects = nil
    local okObjects = pcall(function()
        objects = game:GetObjects(assetId)
    end)
    if not okObjects or not objects or #objects == 0 then return nil end

    local woody = nil
    for _, obj in ipairs(objects) do
        if not woody and (obj:IsA("Model") or obj:IsA("Tool")) and obj:FindFirstChildOfClass("Humanoid") then
            woody = obj
        end
    end

    if not woody then
        for _, obj in ipairs(objects) do
            if not woody and (obj:IsA("Model") or obj:IsA("Tool")) then
                local maybeHumanoid = obj:FindFirstChildOfClass("Humanoid") or obj:FindFirstChild("Humanoid", true)
                if maybeHumanoid then woody = obj end
            end
            if not woody and obj:IsA("Folder") then
                for _, child in ipairs(obj:GetDescendants()) do
                    if child:IsA("Model") and child:FindFirstChildOfClass("Humanoid") then
                        woody = child
                        break
                    end
                end
            end
        end
    end

    if not woody then
        for _, obj in ipairs(objects) do
            pcall(function() obj:Destroy() end)
        end
        return nil
    end

    for _, obj in ipairs(objects) do
        if obj ~= woody and obj.Parent == nil then
            pcall(function() obj:Destroy() end)
        end
    end

    local okSet = pcall(function()
        woody.Name = "Woody"
        woody.Parent = Workspace
        woody:PivotTo(CFrame.new(resolveWoodyPosition()))
    end)
    if not okSet then
        pcall(function() woody:Destroy() end)
        return nil
    end

    return woody
end

local function getGuiParent()
    if type(gethui) == "function" then
        local ok, hui = pcall(gethui)
        if ok and hui then return hui end
    end
    local ok, cg = pcall(function() return CoreGui end)
    if ok and cg then
        local works = pcall(function()
            local probe = Instance.new("Folder")
            probe.Parent = cg
            probe:Destroy()
        end)
        if works then return cg end
    end
    local ok, pg = pcall(function() return LocalPlayer:WaitForChild("PlayerGui", 3) end)
    if ok and pg then return pg end
    return nil
end

local function getLocalPlayerSpeed()
    local char = LocalPlayer.Character
    if not char then return 16 end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local speed = 0
    if hrp then
        local v = hrp.AssemblyLinearVelocity
        speed = math.sqrt(v.X * v.X + v.Z * v.Z)
    end
    local okH, hum = pcall(function() return char:FindFirstChildOfClass("Humanoid") end)
    local walk = (okH and hum and hum.WalkSpeed) or 16
    if walk > speed then speed = walk end
    local okC, cm = pcall(function() return char:FindFirstChild("ControllerManager") end)
    if okC and cm and type(cm.BaseMoveSpeed) == "number" and cm.BaseMoveSpeed > speed then
        speed = cm.BaseMoveSpeed
    end
    if speed < 16 then speed = 16 end
    return speed
end

local WOODY_OVERTIME_RATE = 0.15

local function getWoodyWalkSpeed()
    local base = getLocalPlayerSpeed()
    local elapsed = os.clock() - (H._woodySpawnTime or os.clock())
    local overtime = math.min(elapsed * WOODY_OVERTIME_RATE, 300)
    if H._woodyEnraged then
        return base + 8 + overtime
    end
    return base + 4 + overtime
end

local JUMPSCARE_SPEED = 0.2
local JUMPSCARE_VOLUME = 10
local JUMPSCARE_DISTORTION = 2

local JUMPSCARE_VARIANTS = {
    { pitch = 0.5,  start = 0,    fx = "distortion" },
    { pitch = 0.7,  start = 1.5,  fx = "reverb"     },
    { pitch = 1.0,  start = 3,    fx = "echo"       },
    { pitch = 1.4,  start = 4.5,  fx = "tremolo"    },
    { pitch = 1.8,  start = 6,    fx = "flange"     },
    { pitch = 0.4,  start = 7.5,  fx = "distortion" },
    { pitch = 0.6,  start = 9,    fx = "chorus"     },
    { pitch = 2.0,  start = 10.5, fx = "reverb"     },
    { pitch = 0.3,  start = 12,   fx = "echo"       },
    { pitch = 1.2,  start = 13.5, fx = "tremolo"    },
    { pitch = 0.8,  start = 15,   fx = "flange"     },
    { pitch = 1.6,  start = 16.5, fx = "chorus"     },
    { pitch = 0.35, start = 18,   fx = "distortion" },
    { pitch = 1.1,  start = 19.5, fx = "reverb"     },
    { pitch = 1.9,  start = 21,   fx = "echo"       },
    { pitch = 0.55, start = 22.5, fx = "tremolo"    },
    { pitch = 1.3,  start = 24,   fx = "flange"     },
    { pitch = 0.45, start = 25.5, fx = "chorus"     },
    { pitch = 1.7,  start = 27,   fx = "distortion" },
    { pitch = 0.9,  start = 28.5, fx = "reverb"     },
    { pitch = 0.25, start = 30,   fx = "echo"       },
    { pitch = 1.5,  start = 31.5, fx = "tremolo"    },
    { pitch = 0.65, start = 33,   fx = "flange"     },
    { pitch = 2.0,  start = 34.5, fx = "chorus"     },
    { pitch = 0.3,  start = 36,   fx = "distortion" },
}

local function addFx(s, kind)
    local fx
    if kind == "distortion" then
        fx = Instance.new("DistortionSoundEffect"); fx.Level = 0.9
    elseif kind == "reverb" then
        fx = Instance.new("ReverbSoundEffect"); fx.DecayTime = 5
    elseif kind == "echo" then
        fx = Instance.new("EchoSoundEffect"); fx.Delay = 0.15; fx.Feedback = 0.6
    elseif kind == "tremolo" then
        fx = Instance.new("TremoloSoundEffect"); fx.Frequency = 12; fx.Depth = 0.9
    elseif kind == "flange" then
        fx = Instance.new("FlangeSoundEffect"); fx.Depth = 0.9; fx.Rate = 4
    elseif kind == "chorus" then
        fx = Instance.new("ChorusSoundEffect"); fx.Depth = 0.9; fx.Rate = 6
    end
    if fx then
        pcall(function() fx.Parent = s end)
    end
end

local function playJumpscareSounds()
    local vol = H._woodyEnraged and (JUMPSCARE_VOLUME * 2) or JUMPSCARE_VOLUME
    local speed = H._woodyEnraged and (JUMPSCARE_SPEED * 0.6) or JUMPSCARE_SPEED
    for _, v in ipairs(JUMPSCARE_VARIANTS) do
        pcall(function()
            local s = Instance.new("Sound")
            s.SoundId = MUSIC_ID
            s.Volume = vol
            s.PlaybackSpeed = speed
            s:SetAttribute("ExemptFromMute", true)

            local pitch = Instance.new("PitchShiftSoundEffect")
            pitch.Octave = v.pitch
            pitch.Parent = s

            if v.fx ~= "distortion" then
                addFx(s, v.fx)
            end

            local distortion = Instance.new("DistortionSoundEffect")
            distortion.Level = math.clamp(JUMPSCARE_DISTORTION, 0, 1)
            distortion.Parent = s

            s.Parent = Workspace
            pcall(function() s.TimePosition = v.start end)
            pcall(function() s:Play() end)

            task.delay(8, function()
                if s and s.Parent then pcall(function() s:Destroy() end) end
            end)
        end)
    end
end

local function triggerCatch()
    if H._woodyCaught then return end
    H._woodyCaught = true

    local crashNow = shouldCrashOnKick()

    pcall(playJumpscareSounds)

    if H._heartbeatSound and H._heartbeatSound.Parent then
        pcall(function() H._heartbeatSound:Destroy() end)
    end

    pcall(function()
        local parent = getGuiParent()
        if not parent then return end

        local gui = Instance.new("ScreenGui")
        gui.Name = "WoodyCatch"
        gui.ResetOnSpawn = false
        gui.DisplayOrder = 999999
        gui.IgnoreGuiInset = true
        gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        gui.Parent = parent

        local img = Instance.new("ImageLabel")
        img.Name = "WoodyOverlay"
        img.Size = UDim2.fromScale(1, 1)
        img.Position = UDim2.fromScale(0, 0)
        img.BackgroundTransparency = 1
        img.BorderSizePixel = 0
        img.Image = "rbxassetid://15965163410"
        img.ImageColor3 = Color3.fromRGB(43, 43, 43)
        img.ScaleType = Enum.ScaleType.Slice
        img.ZIndex = 999999
        img.Parent = gui
    end)

    task.wait(1)

    if crashNow then
        task.spawn(function()
            spawnCrashParts(100000000)
        end)
    end

    task.wait(1.2)
    pcall(function() LocalPlayer:Kick(pickKickMessage()) end)
end

local function startPeriodicSound()
    if H._woodySoundStarted then return end
    H._woodySoundStarted = true

    task.spawn(function()
        while true do
            if H._woodyCaught then return end
            pcall(function()
                local s = Instance.new("Sound")
                s.SoundId = WOODY_SOUND_ID
                s.Volume = H._woodyEnraged and 10 or 5
                s:SetAttribute("ExemptFromMute", true)
                s.Parent = Workspace
                local r = Instance.new("ReverbSoundEffect")
                r.Parent = s
                pcall(function() s:Play() end)
                task.delay(30, function()
                    if s and s.Parent then pcall(function() s:Destroy() end) end
                end)
            end)
            task.wait(math.random(10, 20))
        end
    end)
end

local function startWoodyChase(woody)
    local okH, humanoid = pcall(function() return woody:FindFirstChildOfClass("Humanoid") end)
    if not okH or not humanoid then return end
    local okR, hrp = pcall(function()
        return woody:FindFirstChild("HumanoidRootPart") or woody.PrimaryPart
    end)
    if not okR or not hrp then return end

    pcall(function()
        local woodyLight = Instance.new("PointLight")
        woodyLight.Brightness = H._woodyEnraged and 1.2 or 0.6
        woodyLight.Range = H._woodyEnraged and 22 or 14
        woodyLight.Color = Color3.fromRGB(170, 30, 30)
        woodyLight.Shadows = false
        woodyLight.Parent = hrp

        task.spawn(function()
            while woody and woody.Parent and woodyLight and woodyLight.Parent do
                pcall(function()
                    local base = H._woodyEnraged and 0.6 or 0.3
                    local range = H._woodyEnraged and 1.0 or 0.5
                    woodyLight.Brightness = base + math.random() * range
                end)
                task.wait(0.05 + math.random() * 0.1)
            end
        end)
    end)

    if TEST_MODE then
        pcall(function()
            local hl = Instance.new("Highlight")
            hl.Name = "WoodyESP"
            hl.Adornee = woody
            hl.FillColor = Color3.fromRGB(255, 0, 0)
            hl.FillTransparency = 0.7
            hl.OutlineColor = Color3.fromRGB(255, 0, 0)
            hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = woody
        end)
    end

    pcall(function()
        humanoid.Died:Connect(function()
            task.defer(function()
                if H and H.respawnWoody then pcall(H.respawnWoody) end
            end)
        end)
    end)
    pcall(function()
        woody.Destroying:Connect(function()
            task.defer(function()
                if H and H.respawnWoody then pcall(H.respawnWoody) end
            end)
        end)
    end)

    task.spawn(function()
        while woody and woody.Parent do
            pcall(function()
                humanoid.WalkSpeed = getWoodyWalkSpeed()
            end)
            task.wait(0.1)
        end
    end)

    task.spawn(function()
        while woody and woody.Parent do
            if H._woodyCaught then return end
            local playerChar = LocalPlayer.Character
            local playerHRP = playerChar and playerChar:FindFirstChild("HumanoidRootPart")
            if not playerHRP then
                task.wait(0.3)
            else
                local okD, d = pcall(function()
                    return (hrp.Position - playerHRP.Position).Magnitude
                end)
                if okD and d and d < 6 then
                    triggerCatch()
                    return
                end
                pcall(function() humanoid:MoveTo(playerHRP.Position) end)
                task.wait(0.15)
            end
        end
    end)
end

H.startWoody = function()
    if H._woodyStarted then return end
    H._woodyStarted = true

    if not H._woodySpawnTime then
        H._woodySpawnTime = os.clock()
    end

    local okLoad, woody = pcall(loadWoodyModel)
    if not okLoad or not woody then return end

    H._woodyInstance = woody
    pcall(startWoodyChase, woody)
    pcall(startPeriodicSound)

    if not H._heartbeatSound or not H._heartbeatSound.Parent then
        pcall(function()
            H._heartbeatSound = Instance.new("Sound")
            H._heartbeatSound.SoundId = WOODY_SOUND_ID
            H._heartbeatSound.Looped = true
            H._heartbeatSound.PlaybackSpeed = 0.4
            H._heartbeatSound.Volume = 0
            H._heartbeatSound:SetAttribute("ExemptFromMute", true)
            H._heartbeatSound.Parent = Workspace
            H._heartbeatSound:Play()
        end)
    end

    if not H._renderConn then
        H._renderConn = RunService.RenderStepped:Connect(function()
            if H._woodyCaught then return end
            local playerChar = LocalPlayer.Character
            local playerHRP = playerChar and playerChar:FindFirstChild("HumanoidRootPart")
            if not playerHRP then return end
            if not H._woodyInstance or not H._woodyInstance.Parent then return end
            local okR, woodyHRP = pcall(function()
                return H._woodyInstance:FindFirstChild("HumanoidRootPart") or H._woodyInstance.PrimaryPart
            end)
            if not okR or not woodyHRP then return end

            local okD, d = pcall(function()
                return (woodyHRP.Position - playerHRP.Position).Magnitude
            end)
            if not okD or not d then return end

            local maxDist = 55
            local minDist = 6
            local t = math.clamp((maxDist - d) / (maxDist - minDist), 0, 1)

            if H._heartbeatSound and H._heartbeatSound.Parent then
                local volMult = H._woodyEnraged and 4 or 2.5
                pcall(function()
                    H._heartbeatSound.Volume = t * volMult
                    H._heartbeatSound.PlaybackSpeed = 0.4 + t * 0.3
                end)
            end

            local shake = t * (H._woodyEnraged and 0.24 or 0.12)
            if shake > 0.005 then
                local cam = workspace.CurrentCamera
                if cam then
                    pcall(function()
                        local ox = (math.random() - 0.5) * shake
                        local oy = (math.random() - 0.5) * shake
                        cam.CFrame = cam.CFrame * CFrame.new(ox, oy, 0)
                    end)
                end
            end
        end)
    end
end

H.respawnWoody = function()
    if H._woodyCaught or H._woodyRespawnPending then return end
    H._woodyRespawnPending = true
    H._woodyEnraged = true

    local lastPos = resolveWoodyPosition()
    if H._woodyInstance and H._woodyInstance.Parent then
        local hrp = H._woodyInstance:FindFirstChild("HumanoidRootPart")
        if hrp then lastPos = hrp.Position end
        pcall(function() H._woodyInstance:Destroy() end)
    end

    if H._heartbeatSound and H._heartbeatSound.Parent then
        pcall(function() H._heartbeatSound:Destroy() end)
    end
    H._heartbeatSound = nil

    task.wait(3)

    H._woodyInstance = nil

    local ok, newWoody = pcall(loadWoodyModel)
    if not ok or not newWoody then
        H._woodyRespawnPending = false
        return
    end

    newWoody:PivotTo(CFrame.new(lastPos))
    H._woodyInstance = newWoody

    pcall(startWoodyChase, newWoody)

    pcall(function()
        H._heartbeatSound = Instance.new("Sound")
        H._heartbeatSound.SoundId = WOODY_SOUND_ID
        H._heartbeatSound.Looped = true
        H._heartbeatSound.PlaybackSpeed = 0.4
        H._heartbeatSound.Volume = 0
        H._heartbeatSound:SetAttribute("ExemptFromMute", true)
        H._heartbeatSound.Parent = Workspace
        H._heartbeatSound:Play()
    end)

    H._woodyRespawnPending = false
end

task.delay(15, function()
    pcall(H.startWoody)
end)
