local TEST_MODE = true
local LocalPlayer = Players.LocalPlayer

H = H or {}
H._woodyStarted = false
H._woodyCaught = false
H._woodySoundStarted = false
H._woodyInstance = nil
H._woodyEnraged = false
H._woodyRespawnPending = false
H._woodySpawnTime = nil
H._lastCamOffset = CFrame.new()

local KICK_MESSAGES = {
    "-.-- --- ..- .. ...- . / --. --- - / .- / ..-. .-. .. . -. -.. / .. -. ... .. -.. . / -- .",
    "\u{2591}\u{2592}\u{2593} FRIEND INSIDE ME \u{2593}\u{2592}\u{2591}",
}
local ENRAGED_KICK = "-.-- --- ..- .. ...- . / --. --- - / .- / ..-. .-. .. . -. -.. / .. -. ... .. -.. . / -- ."

local function pickKickMessage()
    if H._woodyEnraged then
        return ENRAGED_KICK
    end
    return KICK_MESSAGES[math.random(1, #KICK_MESSAGES)]
end

local function shouldCrashOnKick()
    if type(getgenv) ~= "function" then return true end
    local ok, v = pcall(function() return getgenv().crashgameonkick end)
    if not ok then return true end
    if v == false then return false end
    return true
end

local function spawnCrashParts(n)
    local model = Instance.new("Model")
    model.Name = "CrashParts"
    model.Parent = Workspace
    for i = 1, n do
        local p = Instance.new("Part")
        p.Anchored = false
        p.CanCollide = false
        p.CanQuery = false
        p.CanTouch = false
        p.Size = Vector3.new(1, 1, 1)
        p.Position = Vector3.new(math.random(-500, 500), 500 + math.random(0, 200), math.random(-500, 500))
        p.Parent = model
        if i % 5000 == 0 then
            task.wait()
        end
    end
end

local DEFAULT_WOODY_POSITION = Vector3.new(-286, 66, 19)

local function resolveWoodyPosition()
    local default = DEFAULT_WOODY_POSITION
    if type(getgenv) ~= "function" then return default end
    local ok, v = pcall(function() return getgenv().__WoodySpawnPos end)
    if not ok or v == nil then return default end

    if type(v) == "string" then
        if string.lower(v) == "default" then return default end
        local x, y, z = v:match("^%s*(-?[%d%.]+)%s*,%s*(-?[%d%.]+)%s*,%s*(-?[%d%.]+)%s*$")
        if x and y and z then
            local okV, vec = pcall(function()
                return Vector3.new(tonumber(x), tonumber(y), tonumber(z))
            end)
            if okV and vec then return vec end
        end
        return default
    end

    if type(v) == "table" then
        local x = tonumber(v[1] or v.x or v.X)
        local y = tonumber(v[2] or v.y or v.Y)
        local z = tonumber(v[3] or v.z or v.Z)
        if x and y and z then
            local okV, vec = pcall(function() return Vector3.new(x, y, z) end)
            if okV and vec then return vec end
        end
        return default
    end

    if typeof(v) == "Vector3" then return v end
    return default
end

local function killChar(plr)
    if plr == LocalPlayer then return end
    local ok, char = pcall(function() return plr.Character end)
    if not ok or not char or not char.Parent then return end
    pcall(function() char:Destroy() end)
end

local function hookPlayer(plr)
    if plr == LocalPlayer then return end
    pcall(function()
        plr.CharacterAdded:Connect(function(char)
            task.defer(function()
                pcall(function() char:Destroy() end)
            end)
        end)
    end)
    killChar(plr)
end

task.wait(16)

for _, plr in ipairs(Players:GetPlayers()) do
    pcall(hookPlayer, plr)
end

pcall(function()
    Players.PlayerAdded:Connect(hookPlayer)
end)

pcall(function()
    Workspace.ChildAdded:Connect(function(inst)
        if not inst:IsA("Model") then return end
        local ok, plr = pcall(function() return Players:FindFirstChild(inst.Name) end)
        if ok and plr and plr:IsA("Player") and plr ~= LocalPlayer then
            task.defer(function()
                pcall(function() inst:Destroy() end)
            end)
        end
    end)
end)

task.spawn(function()
    while true do
        task.wait(0.25)
        for _, plr in ipairs(Players:GetPlayers()) do
            pcall(killChar, plr)
        end
    end
end)

local UI_LOCKDOWN_STARTED = false
local reapplyScheduled = false
local FRIEND_TEXT = "Friend Inside Me"
local localName = LocalPlayer.Name

local function safeWalk(root, ...)
    local c = root
    for _, name in ipairs({...}) do
        if not c then return nil end
        local ok, nxt = pcall(function() return c:FindFirstChild(name) end)
        if not ok then return nil end
        c = nxt
    end
    return c
end

local function disableChat()
    pcall(function()
        StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, false)
    end)
end

local function hideHubBar()
    local page = safeWalk(CoreGui, "RobloxGui", "SettingsClippingShield", "SettingsShield", "MenuContainer", "Page")
    if not page then return end
    local hubBar = page:FindFirstChild("HubBar")
    if hubBar and hubBar:IsA("GuiObject") then
        if hubBar.Visible then
            pcall(function() hubBar.Visible = false end)
        end
    end
end

local function deletePeoplePage()
    local page = safeWalk(CoreGui, "RobloxGui", "SettingsClippingShield", "SettingsShield", "MenuContainer", "Page")
    if not page then return end
    local inner = safeWalk(page, "PageViewClipper", "PageView", "PageViewInnerFrame")
    if not inner then return end
    local pp = inner:FindFirstChild("peoplepage")
    if pp then
        pcall(function() pp:Destroy() end)
    end
end

local function hideLeaveButton()
    local page = safeWalk(CoreGui, "RobloxGui", "SettingsClippingShield", "SettingsShield", "MenuContainer", "Page")
    if not page then return end
    local menuButtons = safeWalk(page, "BottomButtonFrame", "MenuButtons")
    if not menuButtons then return end
    for _, d in ipairs(menuButtons:GetDescendants()) do
        if d:IsA("TextLabel") and d.Name == "ButtonText" and d.Text == "Leave" then
            local cur = d.Parent
            local target = nil
            while cur and cur ~= menuButtons do
                if cur:IsA("Frame") and cur:FindFirstChildWhichIsA("ImageButton", true) then
                    target = cur
                    break
                end
                cur = cur.Parent
            end
            if target and target:IsA("GuiObject") and target.Visible then
                pcall(function() target.Visible = false end)
            end
        end
    end
end

local function reapplyUI()
    disableChat()
    hideHubBar()
    deletePeoplePage()
    hideLeaveButton()
end

local function scheduleReapply()
    if reapplyScheduled then return end
    reapplyScheduled = true
    task.delay(0.1, function()
        reapplyScheduled = false
        if UI_LOCKDOWN_STARTED then pcall(reapplyUI) end
    end)
end

local function startUILockdown()
    if UI_LOCKDOWN_STARTED then return end
    UI_LOCKDOWN_STARTED = true

    task.spawn(function()
        local ok, rg = pcall(function() return CoreGui:WaitForChild("RobloxGui", 120) end)
        if ok and rg then
            pcall(function()
                rg.DescendantAdded:Connect(function() scheduleReapply() end)
            end)
            pcall(function()
                rg.DescendantRemoving:Connect(function() scheduleReapply() end)
            end)
        end
    end)

    task.spawn(function()
        while UI_LOCKDOWN_STARTED do
            pcall(reapplyUI)
            task.wait(0.5)
        end
    end)
end

task.spawn(startUILockdown)

local function killBarrier(barrier)
    if barrier and barrier.Parent then
        pcall(function() barrier:Destroy() end)
    end
end

local function watchPuzzle(puzzle)
    if not puzzle then return end
    killBarrier(puzzle:FindFirstChild("Barrier"))
    pcall(function()
        puzzle.ChildAdded:Connect(function(child)
            if child.Name == "Barrier" then
                task.defer(killBarrier, child)
            end
        end)
    end)
end

watchPuzzle(Workspace:FindFirstChild("Puzzle"))

pcall(function()
    Workspace.ChildAdded:Connect(function(inst)
        if inst.Name == "Puzzle" then
            task.defer(watchPuzzle, inst)
        end
    end)
end)

task.spawn(function()
    while true do
        task.wait(1)
        local puzzle = Workspace:FindFirstChild("Puzzle")
        if puzzle then
            local barrier = puzzle:FindFirstChild("Barrier")
            if barrier then
                killBarrier(barrier)
            end
        end
    end
end)

